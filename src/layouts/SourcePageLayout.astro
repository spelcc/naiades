---
interface Props {
  title: string;
  description?: string;
  manifest: {
    html: { lang: string; wfDomain: string; wfPage: string; wfSite: string };
    headStyles: string[];
  };
}
const { title, description = "", manifest } = Astro.props;
import { withBasePath } from "../lib/source-pages";
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || withBasePath("/api/contact");
---
<!doctype html>
<html
  lang={manifest.html.lang || "fr"}
  data-wf-domain={manifest.html.wfDomain}
  data-wf-page={manifest.html.wfPage}
  data-wf-site={manifest.html.wfSite}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content="Astro + Keystatic" />
    <link rel="stylesheet" href={withBasePath("/fonts/google-fonts.css")} />
    <link rel="stylesheet" href={withBasePath("/styles/original-webflow.css")} />
    <link rel="stylesheet" href={withBasePath("/styles/site-extensions.css")} />
    <link rel="shortcut icon" href={withBasePath("/assets/vendor/cdn-prod-website-files-com/8b307f61a8-6746efca8d698f8d74d752cf_Illustration_sans_titre-2.jpg")} />
    {manifest.headStyles.map((css) => <style is:inline set:html={css} />)}
    <script is:inline>
      (function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart" in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")})(window,document);
    </script>
  </head>
  <body data-contact-endpoint={contactEndpoint}>
    <slot />
    <script is:inline>
      const prepareLocalForms = () => {
        document.querySelectorAll(".w-form form").forEach((form) => {
          const captcha = form.querySelector(".w-form-formrecaptcha");
          if (captcha) {
            captcha.removeAttribute("data-sitekey");
            captcha.classList.remove("g-recaptcha", "g-recaptcha-error", "g-recaptcha-disabled");
          }
          const submit = form.querySelector('input[type="submit"], button[type="submit"]');
          if (submit instanceof HTMLInputElement || submit instanceof HTMLButtonElement) {
            submit.disabled = false;
            submit.classList.remove("w-form-loading");
          }
        });
      };
      prepareLocalForms();
      document.addEventListener("DOMContentLoaded", prepareLocalForms, { once: true });
      window.setTimeout(prepareLocalForms, 250);
      window.setTimeout(prepareLocalForms, 1000);

      const updateCopyrightYear = () => {
        const year = String(new Date().getFullYear());
        document.querySelectorAll(".copyright-text-wrapper .button-text").forEach((element) => {
          if (!(element instanceof HTMLElement)) return;
          element.textContent = (element.textContent || "").replace(/(©\s*)\d{4}/, "$1" + year);
        });
      };
      updateCopyrightYear();
      document.addEventListener("DOMContentLoaded", updateCopyrightYear, { once: true });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const question = target.closest(".uui-faq02_question");
        if (!question) return;
        const accordion = question.closest(".uui-faq02_accordion");
        const answer = accordion?.querySelector(".uui-faq02_answer");
        if (!(accordion instanceof HTMLElement) || !(answer instanceof HTMLElement)) return;

        const isOpen = accordion.dataset.faqOpen === "true";
        accordion.dataset.faqOpen = isOpen ? "false" : "true";
        answer.style.height = isOpen ? "0px" : "auto";
        accordion.style.backgroundColor = isOpen ? "rgb(255, 255, 255)" : "rgb(244, 235, 226)";

        const vertical = accordion.querySelector(".accordion-icon_vertical-line");
        if (vertical instanceof HTMLElement) {
          vertical.style.transform = isOpen ? "" : "rotate(90deg) scaleY(0)";
        }
      });

      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.closest(".w-form")) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        const wrapper = form.closest(".w-form");
        const success = wrapper?.querySelector(".w-form-done");
        const failure = wrapper?.querySelector(".w-form-fail");
        try {
          const endpoint = document.body.dataset.contactEndpoint || "/api/contact";
          const response = await fetch(endpoint, { method: "POST", body: new FormData(form) });
          if (!response.ok) throw new Error("submit failed");
          form.style.display = "none";
          if (success instanceof HTMLElement) success.style.display = "block";
          if (failure instanceof HTMLElement) failure.style.display = "none";
        } catch {
          if (failure instanceof HTMLElement) failure.style.display = "block";
        }
      }, true);
    </script>
  </body>
</html>
