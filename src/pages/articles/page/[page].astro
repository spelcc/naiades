---
import SourcePageLayout from "../../../layouts/SourcePageLayout.astro";
import { getArticleListPageCount, renderArticleListPage } from "../../../lib/articles-list-page";

export async function getStaticPaths() {
  const totalPages = await getArticleListPageCount();
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) } };
  });
}

const pageNumber = Number(Astro.params.page || "1");
const page = await renderArticleListPage(pageNumber);
---
<SourcePageLayout
  title={page.settings.title + " · Page " + page.currentPage + " · Naïades Tattoo"}
  description={page.settings.intro}
  manifest={page.skin.manifest}
>
  <Fragment set:html={page.pageHtml} />
</SourcePageLayout>
