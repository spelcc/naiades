---
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import { isPublishedArticle } from "../../lib/article-visibility";

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const entries = await reader.collections.articles.all();
  return entries
    .filter(({ entry }) =>
      isPublishedArticle(entry)
      && (entry.legacySourceId || "").startsWith("blog__")
    )
    .map(({ slug }) => ({ params: { slug } }));
}

const slug = Astro.params.slug || "";
return Astro.redirect("/articles/" + slug, 301);
---
