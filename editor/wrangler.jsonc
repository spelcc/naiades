{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "naiades-keystatic",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "naiades.irz.fr",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CONTACT_SUBMISSIONS",
      "id": "bf1ed0f1dfd1428c9949e0ab63e6dc08"
    },
    {
      "binding": "SESSION",
      "id": "2495e0c2a849490b9ec30ba17f6081a5"
    }
  ],
  "vars": {
    "PUBLIC_KEYSTATIC_GITHUB_APP_SLUG": "spelcc-keystatic"
  }
}
